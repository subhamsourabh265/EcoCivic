# Phase 1 tooling requires no environment variables or running services.
# This file documents planned local conventions; nothing loads it automatically.
# Add app/service-specific examples when those runtimes are implemented.

# Public browser configuration (Phase 2+). Never put secrets in VITE_* values.
# VITE_API_BASE_URL=http://localhost:3000

# Server-only configuration (Phase 4+).
# API_GATEWAY_PORT=3000
# DATABASE_URL=postgresql://ecocivic:local_only@localhost:5432/ecocivic

# OIDC configuration will follow the authentication architecture decision.
# Never commit real credentials, client secrets, or tokens.
